# Optional external harness configuration
AUTOSKILL_HARNESS_DIR=/path/to/my_claude_harness
AUTOSKILL_BUN_BIN=/path/to/bun
AUTOSKILL_TASKS_DIR=/path/to/benchmark/tasks
AUTOSKILL_RUNS_DIR=/path/to/runs
SKILL_TRANSFER_DIR=/path/to/skill_transfer
R_TASKS_DIR=/path/to/biodsbench_r/tasks
BEST_SKILL=/path/to/best_skill.md
EVAL_TIMEOUT=3000

# BioDSBench evaluation provider; never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.example.com
ANTHROPIC_MODEL=your-model
QWEN_API_KEY=
QWEN_BASE_URL=https://api.example.com/v1
QWEN_MODEL=your-model

# Optional OpenAI-compatible endpoint for LLM skill generalization
AUTOSKILL_LLM_BASE_URL=https://api.openai.com/v1
AUTOSKILL_LLM_MODEL=gpt-4o-mini
AUTOSKILL_LLM_API_KEY=
